# Copy to .env and set the controller host's real LAN address.
# Use a stable wired address reachable from both the Dot and Home Assistant.
SERVER_IP=192.0.2.10
SERVER_HOST=0.0.0.0
SERVER_PORT=8767
SERVER_TLS_PORT=8770
API_PORT=8768
MDNS_NAME=echomuse-pilot
EM_ESPHOME_PORT_BASE=16001
ESPHOME_PROJECT_VERSION=2.26.0
DB_PATH=/app/data/echomuse.db
DEVICE_APPROVAL=strict
# Keep bootstrap connections possible until the only pilot Dot has its
# controller CA/token and the dashboard proves its link is wss (TLS).
REQUIRE_DEVICE_TLS=0
OWW_MODEL=hey_jarvis
OWW_THRESHOLD=0.5
# Keep the default initially. Change only after measuring a slow HA turn.
EM_TTS_WAIT_TIMEOUT=30
DEBUG=0
LOG_LEVELS=
# Optional: mount the private CA certificate and set its container path.
EM_EXTRA_CA_CERT=
