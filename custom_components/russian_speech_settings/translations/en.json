        "data": {
          "endpoint": "HTTPS service origin",
          "token": "Service token",
          "ca_file": "CA certificate path inside HA"
        }
      },
      "reauth_confirm": {
        "title": "Service token",
        "data": {
          "token": "Service token"
        }
      }
